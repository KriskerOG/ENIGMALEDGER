# Copy to .env.local for development. Never commit real secrets.

# PostgreSQL connection for normalized ENIGMA data.
DATABASE_URL="postgres://user:password@localhost:5432/enigma"

# UEX public trade endpoints work without a token; set a token if your UEX account needs authenticated quota.
UEX_API_TOKEN=""
UEX_CLIENT_VERSION="enigma-verse-index/0.1.0"

# Optional override after confirming SC Trade Tools Swagger paths.
SC_TRADE_TOOLS_API_BASE_URL="https://sc-trade.tools/api"

# Optional Redis-compatible edge rate limiting via Upstash REST.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Runtime behavior.
NEXT_PUBLIC_SITE_NAME="ENIGMA Verse Index"

# KOOK bot webhook integration.
# Configure the callback URL in KOOK as:
# https://your-domain.example/api/kook/webhook?compress=0
KOOK_BOT_TOKEN=""
KOOK_VERIFY_TOKEN=""
KOOK_ENCRYPT_KEY=""
KOOK_API_BASE_URL="https://www.kookapp.cn/api/v3"

# Optional daily news translation sync.
# Public users do not trigger paid translation. Cron/sync calls must pass this secret.
NEWS_SYNC_SECRET=""
NEWS_TRANSLATION_PROVIDER="none" # none | google | microsoft
GOOGLE_TRANSLATE_API_KEY=""
MICROSOFT_TRANSLATOR_KEY=""
MICROSOFT_TRANSLATOR_REGION=""
MICROSOFT_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"
NEWS_TRANSLATION_MAX_ARTICLES_PER_RUN="3"
NEWS_TRANSLATION_MAX_CHARS_PER_ARTICLE="3000"
NEWS_TRANSLATION_MAX_CHARS_PER_RUN="9000"
